# PostgreSQL connection used by Prisma (app + CLI)
DATABASE_URL="postgresql://menuchef:menuchef@localhost:5432/menuchef?schema=public"

# Optional: public base URL used for absolute metadata/OG image URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used by the landing page to know which tenant to feature first.
# Optional — API routes always receive the tenant slug explicitly.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG="brasa-burger"

# Optional: set to "true" to disable Prisma query logging in development.
PRISMA_LOG_QUERIES="false"
